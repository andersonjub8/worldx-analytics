# Server-side only. Never expose this in NEXT_PUBLIC_* variables.
UNISAT_API_KEY=YOUR_UNISAT_API_KEY
UNISAT_API_BASE=https://open-api.unisat.io
WORLDX_TICKER=WORLDX
WORLDX_SUPPLY=21000000
# Optional manual/market source if WORLDX price is not available from your chosen market feed.
WORLDX_PRICE_USD=0
# Dashboard refresh/cache in seconds
WORLDX_CACHE_SECONDS=60
